# AI providers
# Compose service env_file path. Keep `.env` locally; set `.env.production` in production.
APP_ENV_FILE=.env
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_CHAT_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-3-flash-preview
QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks

# University identity
UNIVERSITY_NAME=Vietnamese-German University
UNIVERSITY_SHORT_NAME=VGU
UNIVERSITY_WEBSITE=https://vgu.edu.vn/
UNIVERSITY_DOMAIN=vgu.edu.vn

# OCR
USE_SMART_EXTRACTION=true
ENABLE_VISION_FALLBACK=true
OCR_PIPELINE_VERSION=v2
OCR_TESSERACT_LANG=vie+eng
OCR_TEMP_DIR=/app/data/runtime/admissions-ocr


# Optional remote OCR parser. Leave empty to use local Tesseract first, then OpenAI Vision fallback if enabled.
OCR_PARSE_API_KEY=
OCR_PARSE_API_BASE_URL=
OCR_PARSE_POLL_INTERVAL_SECONDS=2
OCR_PARSE_TIMEOUT_SECONDS=600

# Database configuration
POSTGRES_USER=your_migration_db_user
POSTGRES_PASSWORD=your_migration_db_password
POSTGRES_DB=vgu_admissions
POSTGRES_PORT=5432
APP_DATABASE_USER=your_application_db_user
APP_DATABASE_PASSWORD=your_application_db_password
DATABASE_URL=postgresql+psycopg://${APP_DATABASE_USER}:${APP_DATABASE_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Qdrant API Key (for lead enrichment)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HTTPS=false
# For Docker Compose Qdrant, this must match QDRANT__SERVICE__API_KEY on the qdrant service.
# Leave empty only for a Qdrant instance that is intentionally running without API-key auth.
# Railway production with Qdrant Cloud:
# QDRANT_HOST=<cluster-id>.<region>.cloud.qdrant.io
# QDRANT_PORT=443
# QDRANT_HTTPS=true
# QDRANT_API_KEY must be set in Railway service variables, never committed.
QDRANT_API_KEY=

# Cloudflare R2. Leave empty/DATA_REQUIRED in local development to use OCR_TEMP_DIR local storage.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...
R2_PUBLIC_BASE_URL=https://<public-domain-or-r2-dev-domain>

# jwt secret key
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Cookie configuration
# Local HTTP: false
# Production HTTPS: true
COOKIE_SECURE=false

# redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=default

# Retention jobs
MESSAGE_CHUNK_USAGE_RETENTION_ENABLED=true
MESSAGE_CHUNK_USAGE_RETENTION_DAYS=60
MESSAGE_CHUNK_USAGE_RETENTION_RUN_HOUR=3
MESSAGE_CHUNK_USAGE_RETENTION_BATCH_SIZE=1000
MESSAGE_CHUNK_USAGE_RETENTION_MAX_BATCHES=100

CHAT_QUERY_RATE_LIMIT_PER_MINUTE=12
CHAT_QUERY_RATE_LIMIT_PER_HOUR=120
CHAT_QUERY_IP_RATE_LIMIT_PER_MINUTE=30
CHAT_INIT_RATE_LIMIT_PER_MINUTE=10

# Api server configuration
API_PORT=8000
UVICORN_WORKERS=1
# Local development: true. Managed production without Caddy: false.
API_DOCS_ENABLED=true

# Caddy production reverse proxy
# Default `:80` supports local/staging HTTP validation without a real domain.
# Set `CADDY_SITE_ADDRESS=api.your-domain.example.com` only after DNS points to the VPS.
CADDY_SITE_ADDRESS=:80
CADDY_API_UPSTREAM=api:8000
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Trusted hosts (Host header validation)
# Comma-separated list of allowed Host header values.
# Railway production must include your backend deployment domain and healthcheck.railway.app.
TRUSTED_HOSTS=localhost,127.0.0.1,your-backend-domain.example.com,healthcheck.railway.app

# CORS configuration
# Local example:
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://127.0.0.1:3000,https://xxx.ngrok-free.app
# Production example:
# CORS_ALLOW_ORIGINS=https://www.your-domain.example.com,https://admin.your-domain.example.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Backend integration tests
BACKEND_TEST_API_URL=http://127.0.0.1:8000
BACKEND_TEST_ORIGIN=http://localhost:5173
BACKEND_TEST_INVALID_ORIGIN=https://invalid-origin.example.com
BACKEND_TEST_CSRF_ENABLED=false

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# Telegram
# Set your bot token here (do NOT commit real tokens).
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_ENABLED=false

# Zalo Bot (official Zalo Bot API — https://bot.zapps.me/docs)
# Create a bot via the "Zalo Bot Manager" OA in the Zalo app; the token is sent
# to you in a Zalo message. Do NOT commit real tokens.
ZALO_BOT_TOKEN=
# Enable getUpdates long-polling for local/dev. Do NOT enable when a webhook is set.
ZALO_POLLING_ENABLED=false
# Shared secret echoed back by Zalo in the X-Bot-Api-Secret-Token header
# (set it via setWebhook). 8-256 chars. Leave empty to disable verification (local only).
ZALO_WEBHOOK_SECRET=

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_PROXY_MODE=basic
FIRECRAWL_SCRAPE_TIMEOUT_MS=120000
FIRECRAWL_SDK_MAX_RETRIES=0
FIRECRAWL_MAX_ATTEMPTS=2
FIRECRAWL_RETRY_BACKOFF_SECONDS=3
FIRECRAWL_ALLOW_ENHANCED_RETRY=true
VGU_AUTO_SAVE_RAW=true
VGU_AUTO_CREATE_REVIEW_DRAFT=true
VGU_AUTO_PROMOTE_VERIFIED=false
VGU_RAW_CRAWL_DIR=data/vgu_crawl_raw
VGU_REVIEWED_CRAWL_DIR=data/vgu_crawl_reviewed
VGU_IMPORT_DIR=vgu_admissions_import
VGU_SOURCE_REGISTRY_PATH=data/vgu_source_registry.json
VGU_FIELD_REVIEW_REPORT_PATH=data/vgu_field_review_report.md

# Initial admin bootstrap on deploy
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
